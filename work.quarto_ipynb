   "source": [
    "import yaml\n",
    "import os\n",
    "from IPython.display import display, Markdown, HTML\n",
    "\n",
    "with open(\"./assets/portfolio/index.yaml\") as f:\n",
    "    items = yaml.safe_load(f)\n",
    "\n",
    "sorted_items = sorted(items, key=lambda x: (x['dates'][0]['year'], x['dates'][0]['month'], x['title']), reverse=True)\n",
    "filtered_items = [item for item in sorted_items if 'Research' in item['category']]\n",
    "\n",
    "contents = \"<div class='portfolio'>\"\n",
    "for item in filtered_items:\n",
    "    # Get the root url of this item\n",
    "    root_url = os.path.join('.', 'assets', 'portfolio', item['id'])\n",
    "    thumb_url = os.path.join(root_url, 'thumbnail.png')\n",
    "    contents += \"<div class='portfolio_item'>\"\n",
    "    contents += \"<div class='portfolio_item_contents'>\"\n",
    "    contents += f\"<div class='portfolio_item_thumbnail'><img src='{thumb_url}' /></div>\"\n",
    "    contents += f\"<h3>{item['title']}</h3>\"\n",
    "    contents += f\"<p>Click to read more</p>\"\n",
    "    contents += \"</div>\"\n",
    "    contents += \"</div>\"\n",
    "contents += \"</div>\"\n",
    "display(HTML(contents))"
   ]
  }
 ],
